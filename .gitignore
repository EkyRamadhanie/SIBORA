# ==========================================
# SIBORA - .gitignore Configuration
# ==========================================

# --- Local Environment & Secrets ---
backend-laravel/.env
backend-laravel/.env.*
!backend-laravel/.env.example
backend-laravel/auth.json

# --- Composer & PHP Dependencies ---
backend-laravel/vendor/

# --- Laravel Framework & Runtime Cache ---
backend-laravel/bootstrap/cache/*.php
!backend-laravel/bootstrap/cache/.gitignore
backend-laravel/storage/logs/*.log
backend-laravel/storage/framework/cache/data/*
!backend-laravel/storage/framework/cache/data/.gitignore
backend-laravel/storage/framework/sessions/*
!backend-laravel/storage/framework/sessions/.gitignore
backend-laravel/storage/framework/views/*.php
!backend-laravel/storage/framework/views/.gitignore
backend-laravel/storage/*.key

# --- User Uploads (Runtime Media) ---
backend-laravel/public/uploads/sibora/lapangan/*
!backend-laravel/public/uploads/sibora/lapangan/.gitignore
backend-laravel/public/uploads/sibora/peralatan/*
!backend-laravel/public/uploads/sibora/peralatan/.gitignore

# --- Testing & Code Coverage ---
backend-laravel/.phpunit.cache
backend-laravel/.phpunit.result.cache

# --- Node & Frontend Build (if used in future) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# --- Archive & Backup Files ---
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.bak
*.tmp

# --- OS & IDE Artifacts ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.log
