{
  "info": {
    "name": "SIBORA Laravel API",
    "description": "Pengujian dasar REST API SIBORA. Jalankan backend di http://127.0.0.1:8000 dan gunakan token hasil login untuk endpoint terproteksi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "lapanganId", "value": "1" },
    { "key": "transaksiId", "value": "1" },
    { "key": "pembayaranId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Login pelanggan demo",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  pm.collectionVariables.set('token', body.token);", "}"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"dani\",\n  \"password\": \"123456\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Daftar lapangan",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/venues" }
    },
    {
      "name": "Jadwal lapangan",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/venues/{{lapanganId}}/schedule?tanggal=2026-12-10" }
    },
    {
      "name": "Profil pengguna login",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/user/profile" }
    },
    {
      "name": "Riwayat booking",
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/bookings/history" }
    }
  ]
}
